# Preencha com os dados do PostgreSQL (Neon). Não compartilhe nem envie este arquivo preenchido.
JDBC_DATABASE_URL=jdbc:postgresql://SEU_HOST_NEON/SEU_BANCO?sslmode=require
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=SUA_SENHA
ADOCAO_CHAVE=CRIE_UMA_CHAVE_ADMINISTRATIVA_FORTE

# Opcionais (anúncios públicos)
# ADOCAO_MODERACAO=true            # anúncios novos ficam pendentes até você aprovar em /admin.html
# ADOCAO_MAX_ANUNCIOS_IP=3         # anúncios por hora por visitante
# ADOCAO_MAX_ANUNCIOS_GLOBAL=30    # anúncios por hora no total
